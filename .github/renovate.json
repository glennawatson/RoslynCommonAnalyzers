{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:openssf-scorecard"],
  "timezone": "Australia/Melbourne",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "The compiler API takes its version from the per-slot $(MicrosoftCodeAnalysisVersion) in Directory.Build.props, so there is no literal here to bump.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis",
        "Microsoft.CodeAnalysis.Common",
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.CodeAnalysis.CSharp.Workspaces",
        "Microsoft.CodeAnalysis.VisualBasic",
        "Microsoft.CodeAnalysis.VisualBasic.Workspaces",
        "Microsoft.CodeAnalysis.Workspaces.Common"
      ],
      "enabled": false
    },
    {
      "description": "A newer Roslyn means adding a slot, not moving the highest one, so this stays on the dashboard until someone decides.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["Microsoft.CodeAnalysis.CSharp"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The analyzer test verifiers are a matched set and only work on one version together.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\.CodeAnalysis\\.(CSharp|VisualBasic)\\.(Analyzer|CodeFix|CodeRefactoring)\\.Testing$/"],
      "groupName": "analyzer test verifiers"
    },
    {
      "description": "TUnit and the testing-platform coverage extension move together; a mismatch breaks the run rather than a test.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["TUnit", "TUnit.*", "Microsoft.Testing.*"],
      "groupName": "test runner"
    },
    {
      "description": "Each of these can introduce a diagnostic, and this repo builds with warnings as errors. One PR each keeps a red build attributable to the package that caused it.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.Analyzers",
        "StyleCop.Analyzers",
        "Roslynator.*",
        "SonarAnalyzer.*"
      ],
      "groupName": null,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "build-gate"]
    },
    {
      "description": "StyleCop has never shipped a stable 1.2.0.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["StyleCop.Analyzers"],
      "ignoreUnstable": false
    },
    {
      "description": "MinVer decides the shipped version, so a major lands on the dashboard first.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["MinVer"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Benchmarks do not ship and cannot break a consumer.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet", "BenchmarkDotNet.*"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Still a release candidate, so unstable versions are the only ones on offer.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["Microsoft.NETCore.App.Ref"],
      "ignoreUnstable": false
    },
    {
      "description": "The SDK band decides which Roslyn compiles the analyzers.",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk", "msbuild-sdk"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Every action here comes from GitHub, Microsoft or NuGet and is referenced by tag. A third-party action added later still gets the digest pinning config:best-practices turns on.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/*", "github/*", "dotnet/*", "NuGet/*"],
      "pinDigests": false,
      "groupName": "actions"
    }
  ],
  "customManagers": [
    {
      "description": "The highest Roslyn slot. The lower pins are the floor contract and are deliberately untracked.",
      "customType": "regex",
      "managerFilePatterns": ["src/Directory.Build.props"],
      "matchStrings": [
        "'\\$\\(RoslynSlot\\)' == 'roslyn5\\.9'\">\\s*<MicrosoftCodeAnalysisVersion>(?<currentValue>[^<]+)</MicrosoftCodeAnalysisVersion>"
      ],
      "depNameTemplate": "Microsoft.CodeAnalysis.CSharp",
      "datasourceTemplate": "nuget"
    },
    {
      "description": "Pinned in C# because the testing library takes an exact package identity.",
      "customType": "regex",
      "managerFilePatterns": ["src/Shared/Tests/DotNet11ReferenceAssemblies.cs"],
      "matchStrings": [
        "ReferencePackageVersion = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "Microsoft.NETCore.App.Ref",
      "datasourceTemplate": "nuget"
    }
  ]
}
