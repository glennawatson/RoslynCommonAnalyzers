{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:dotnetMonorepo",
    "group:nugetMonorepo",
    "security:openssf-scorecard"
  ],
  "mode": "full",
  "timezone": "Australia/Melbourne",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "recreateWhen": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "The compiler API takes its version from the per-slot $(MicrosoftCodeAnalysisVersion) in Directory.Build.props, so there is no literal here to bump.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.CodeAnalysis$/",
        "/^Microsoft\\.CodeAnalysis\\.Common$/",
        "/^Microsoft\\.CodeAnalysis\\.(CSharp|VisualBasic)$/",
        "/^Microsoft\\.CodeAnalysis\\.(CSharp|VisualBasic)\\.Workspaces$/",
        "/^Microsoft\\.CodeAnalysis\\.Workspaces\\.Common$/"
      ],
      "enabled": false
    },
    {
      "description": "A newer Roslyn means adding a slot, not moving the highest one, so this waits on the dashboard.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/^Microsoft\\.CodeAnalysis\\.CSharp$/"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The analyzer test verifiers only work on one version together.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\.CodeAnalysis\\.(CSharp|VisualBasic)\\.(Analyzer|CodeFix|CodeRefactoring)\\.Testing$/"],
      "groupName": "analyzer test verifiers"
    },
    {
      "description": "TUnit and the testing-platform extensions move together; a mismatch breaks the run rather than a test.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^TUnit(\\.|$)/", "/^Microsoft\\.Testing\\./"],
      "groupName": "test runner"
    },
    {
      "description": "Each of these can introduce a diagnostic and the build treats warnings as errors, so one PR each keeps a red build attributable.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.CodeAnalysis\\.Analyzers$/",
        "/^StyleCop\\.Analyzers$/",
        "/^Roslynator(\\.|$)/",
        "/^SonarAnalyzer(\\.|$)/"
      ],
      "groupName": null,
      "labels": ["dependencies", "build-gate"]
    },
    {
      "description": "StyleCop has never shipped a stable 1.2.0, and 1.2.0-beta.556 has been the newest release since December 2023. Take prereleases and stop flagging the age, since there is nothing to move to.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^StyleCop\\.Analyzers$/"],
      "ignoreUnstable": false,
      "abandonmentThreshold": null
    },
    {
      "description": "MinVer decides the shipped version.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^MinVer$/"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Still a release candidate, so unstable versions are the only ones on offer.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/^Microsoft\\.NETCore\\.App\\.Ref$/"],
      "ignoreUnstable": false
    },
    {
      "description": "The SDK band decides which Roslyn compiles the analyzers.",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk", "msbuild-sdk"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Pinning names the group it pins rather than the generic dependencies topic.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "group": {
        "commitMessageTopic": "GitHub Actions digests"
      }
    },
    {
      "description": "Minor, patch and digest updates to actions from GitHub and Microsoft merge automatically.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^github\\//", "/^microsoft\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Digest updates to Microsoft's, Docker's Dockerfile syntax and ReactiveUI's container images merge automatically.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^mcr\\.microsoft\\.com\\//", "/^ghcr\\.io\\/reactiveui\\//", "docker/dockerfile"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "The highest Roslyn slot. The lower pins are the floor contract and are deliberately untracked.",
      "customType": "regex",
      "managerFilePatterns": ["src/Directory.Build.props"],
      "matchStrings": [
        "'\\$\\(RoslynSlot\\)' == 'roslyn5\\.9'\">\\s*<MicrosoftCodeAnalysisVersion>(?<currentValue>[^<]+)</MicrosoftCodeAnalysisVersion>"
      ],
      "depNameTemplate": "Microsoft.CodeAnalysis.CSharp",
      "datasourceTemplate": "nuget"
    },
    {
      "description": "Pinned in C# because the testing library takes an exact package identity.",
      "customType": "regex",
      "managerFilePatterns": ["src/Shared/Tests/DotNet11ReferenceAssemblies.cs"],
      "matchStrings": [
        "ReferencePackageVersion = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "Microsoft.NETCore.App.Ref",
      "datasourceTemplate": "nuget"
    }
  ]
}
