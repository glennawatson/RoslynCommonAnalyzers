<Project>

  <PropertyGroup>
    <CopyrightStartYear>2023</CopyrightStartYear>
    <CopyrightCurrentYear>$([System.DateTime]::UtcNow.ToString("yyyy"))</CopyrightCurrentYear>
    <CopyrightYearRange Condition="'$(CopyrightCurrentYear)' == '$(CopyrightStartYear)'">$(CopyrightStartYear)</CopyrightYearRange>
    <CopyrightYearRange Condition="'$(CopyrightCurrentYear)' != '$(CopyrightStartYear)'">$(CopyrightStartYear)-$(CopyrightCurrentYear)</CopyrightYearRange>
    <Copyright>Copyright (c) $(CopyrightYearRange) Glenn Watson and Contributors</Copyright>
    <Authors>Glenn Watson and Contributors</Authors>
    <Owners>glennawatson</Owners>
    <Company>Glenn Watson</Company>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/glennawatson/RoslynCommonAnalyzers</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/glennawatson/RoslynCommonAnalyzers/releases</PackageReleaseNotes>
    <!-- PackageTags are per-package: each *.Package project sets its own. -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/glennawatson/RoslynCommonAnalyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Nullable>enable</Nullable>
    <!-- Pinned, not 'latest'. These assemblies are netstandard2.0 and have to compile
         identically on every SDK from .NET 8 up (that range is the whole point of the
         Roslyn slots below), so the language surface must not float with whichever SDK
         happens to be installed. Under 'latest' the .NET 11 SDK resolves C# 15, which
         legalizes collection expression arguments — IDE0028 then demands
         `[with(comparer), ..]` at every `new HashSet<string>(comparer) { .. }`, and that
         rewrite fails to compile on .NET 8/9/10. Raise this deliberately, once the floor
         SDK can parse the syntax being adopted. -->
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <MinVerAutoIncrement>patch</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>

    <!-- Nothing packs by default. Only the .Package project opts back in with
         <IsPackable>true</IsPackable>; the analyzer/code-fix/test projects all
         stay non-packable so a `dotnet pack` of the solution produces exactly
         one .nupkg (StyleSharp.Analyzers). -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- Contains rather than EndsWith: a slot's test sibling carries the slot suffix
         after the word, as in StyleSharp.Analyzers.Tests.Roslyn59. -->
    <IsTestProject>$(MSBuildProjectName.Contains('Tests'))</IsTestProject>
  </PropertyGroup>

  <!--
    Multi-Roslyn targeting. The analyzer + code-fix assemblies are built once per
    Roslyn "slot" and packaged under analyzers/dotnet/<slot>/cs so the SDK loads
    the highest slot <= the host compiler's Roslyn version (CompilerApiVersion).
      roslyn4.8  = floor: .NET 8 SDK (csc 4.11), VS 17.8 (C# 12).
      roslyn4.14 = .NET 9 SDK (csc 4.14), VS 17.14 (C# 13).
      roslyn5.3  = .NET 10 SDK up to 10.0.3xx (csc 5.6), C# 14.
      roslyn5.9  = .NET 10 SDK 10.0.4xx (csc 5.9) and the .NET 11 line
                   (csc 5.11), C# 15: unions, closed hierarchies, collection
                   expression arguments, extension indexers, labeled
                   break/continue, unsafe expressions.
    The slot is chosen by the host's CompilerApiVersion, not by its SDK band, so
    the mapping above is the measured `csc -version` of each SDK rather than a
    guess from the marketing name. No shipping SDK reports exactly 5.3, so that
    slot exists to serve the 5.3-5.8 range (.NET 10 GA through 10.0.302).

    Each slot is a real project rather than a switch on the command line. The
    floor is the plain project (StyleSharp.Analyzers); every higher slot is a
    sibling next to it whose name carries the slot (StyleSharp.Analyzers.Roslyn59)
    and which link-includes the floor project's source, so there is exactly one
    copy of every rule and the leaves differ only in which Roslyn they bind to.
    That means `dotnet build` of the solution builds and `dotnet test` tests every
    shipped assembly, instead of one slot being verified and three being packed on
    trust. The slot is derived from the project-name suffix below, so adding a
    future slot is one new csproj with no further wiring.

    Prefer version-tolerant detection (probe well-known type/interface/attribute
    names structurally, e.g. the IUnion marker check) so one build recognizes new
    constructs on any host; gate genuinely version-specific syntax APIs behind the
    ROSLYN_*_OR_GREATER constants. Keep these assemblies netstandard2.0 (RS1041).
  -->
  <PropertyGroup>
    <IsRoslynComponentProject Condition="$(MSBuildProjectName.Contains('.Analyzers'))
                                         And !$(MSBuildProjectName.Contains('.Tests'))
                                         And !$(MSBuildProjectName.Contains('.Benchmarks'))
                                         And !$(MSBuildProjectName.Contains('.Packages'))">true</IsRoslynComponentProject>
  </PropertyGroup>

  <!-- The slot a component project builds for, read off its name. A project with no
       slot suffix is the floor, which is also the one that owns the source files. -->
  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true'">
    <RoslynSlot>roslyn4.8</RoslynSlot>
    <RoslynSlot Condition="$(MSBuildProjectName.EndsWith('.Roslyn414'))">roslyn4.14</RoslynSlot>
    <RoslynSlot Condition="$(MSBuildProjectName.EndsWith('.Roslyn53'))">roslyn5.3</RoslynSlot>
    <RoslynSlot Condition="$(MSBuildProjectName.EndsWith('.Roslyn59'))">roslyn5.9</RoslynSlot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RoslynSlot)' == 'roslyn4.8'">
    <MicrosoftCodeAnalysisVersion>4.8.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RoslynSlot)' == 'roslyn4.14'">
    <MicrosoftCodeAnalysisVersion>4.14.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RoslynSlot)' == 'roslyn5.3'">
    <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER;ROSLYN_5_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- The first slot whose compiler API exposes the C# 15 syntax model:
       UnionDeclarationSyntax, SyntaxKind.WithElement / ClosedKeyword /
       SafeKeyword / UnsafeExpression, and indexers inside an extension block.
       Rules that need those types compile only here; a host old enough to miss
       this slot cannot compile C# 15 either, so gating costs no coverage. -->
  <PropertyGroup Condition="'$(RoslynSlot)' == 'roslyn5.9'">
    <MicrosoftCodeAnalysisVersion>5.9.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER;ROSLYN_5_OR_GREATER;ROSLYN_5_9_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Everything that only consumes the compiler API — tests, benchmarks, the
       package projects — takes the highest Roslyn the repo builds against rather
       than the floor. A newer one costs them nothing, and referencing a lower one
       than the analyzer under test fails to compile the moment that analyzer is
       built for a higher slot. This drives the central Microsoft.CodeAnalysis.*
       versions in Directory.Packages.props. -->
  <PropertyGroup>
    <MicrosoftCodeAnalysisVersion Condition="'$(MicrosoftCodeAnalysisVersion)' == ''">5.9.0</MicrosoftCodeAnalysisVersion>
  </PropertyGroup>

  <!-- A slot sibling recompiles the floor project's source; only the floor owns files
       on disk. It therefore has to produce the same assembly identity, so a consumer
       loading one slot or another sees the same analyzer rather than two. -->
  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true'">
    <RoslynSlotSourceProject>$(MSBuildProjectName)</RoslynSlotSourceProject>
    <RoslynSlotSourceProject Condition="$(MSBuildProjectName.EndsWith('.Roslyn414'))">$(MSBuildProjectName.Replace('.Roslyn414', ''))</RoslynSlotSourceProject>
    <RoslynSlotSourceProject Condition="$(MSBuildProjectName.EndsWith('.Roslyn53'))">$(MSBuildProjectName.Replace('.Roslyn53', ''))</RoslynSlotSourceProject>
    <RoslynSlotSourceProject Condition="$(MSBuildProjectName.EndsWith('.Roslyn59'))">$(MSBuildProjectName.Replace('.Roslyn59', ''))</RoslynSlotSourceProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true' And '$(RoslynSlotSourceProject)' != '$(MSBuildProjectName)'">
    <AssemblyName>$(RoslynSlotSourceProject)</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Avoid NuGet ID conflicts with the .Package project, which owns the published id. -->
    <PackageId>*$(MSBuildProjectFile)*</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TUnitImplicitUsings>true</TUnitImplicitUsings>
    <TUnitAssertionsImplicitUsings>true</TUnitAssertionsImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Shared Microsoft.Testing.Platform code-coverage settings (exclusions for
         generated code etc); copied next to each test assembly as
         AssemblyName.testconfig.json so the test runner's coverage step uses it. -->
    <None Include="$(MSBuildThisFileDirectory)testconfig.json" Condition="Exists('$(MSBuildThisFileDirectory)testconfig.json')">
      <Link>$(AssemblyName).testconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\icons\icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\icons\icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!--
    The .NET SDK + transitive packages auto-load several source generators that
    have nothing to do in this codebase. Each one still scans the full compilation
    looking for its trigger attribute, so removing them from @(Analyzer) before
    CoreCompile shaves real csc time. Audited usage (re-check before re-enabling):
      ComInterfaceGenerator       — no [GeneratedComInterface]
      ComClassGenerator           — no [GeneratedComClass]
      VtableIndexStubGenerator    — COM vtable, unused
      JSImportGenerator           — no Blazor WASM JS interop
      LibraryImportGenerator      — no [LibraryImport]/[DllImport]
      System.Text.Json.SourceGeneration
                                  — no JsonSerializable contexts
    Re-enable any of these the moment the corresponding attribute is introduced;
    csc will silently produce wrong output otherwise.
  -->
  <Target Name="RemoveUnusedSdkGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'Microsoft.Interop.ComInterfaceGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.ComClassGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.VtableIndexStubGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.JavaScript.JSImportGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.LibraryImportGenerator'
                        or '%(Filename)' == 'System.Text.Json.SourceGeneration'" />
    </ItemGroup>
  </Target>

  <!--
    The RS* rules check code that *declares* analyzers: that every analyzer carries
    DiagnosticAnalyzerAttribute, that every descriptor is release-tracked, and so on. They ride in on
    the compiler API packages, so every project that consumes Roslyn inherits them — including the
    tests and benchmarks, which only ever run analyzers rather than ship them. There, a benchmark
    fixture that implements DiagnosticAnalyzer is held to rules written for a shipped package.

    Excluding the package assets does not remove them. Central transitive pinning re-promotes the
    package, and NuGet keeps a package's assets unless every edge into it excludes them, so the
    assemblies still reach csc. Dropping them from the compiler invocation does work, and matches how
    the unused SDK generators above are handled.

    Projects that do ship analyzers set EnforceExtendedAnalyzerRules and keep the whole ruleset.
  -->
  <Target Name="RemoveAnalyzerAuthoringRules"
          BeforeTargets="CoreCompile"
          Condition="'$(EnforceExtendedAnalyzerRules)' != 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.Analyzers'
                        or '%(Filename)' == 'Microsoft.CodeAnalysis.CSharp.Analyzers'" />
    </ItemGroup>
  </Target>
</Project>
