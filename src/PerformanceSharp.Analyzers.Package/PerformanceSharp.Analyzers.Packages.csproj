<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- One of the packable projects in the repo (see Directory.Build.props); everything else is
         non-packable so a `dotnet pack` of the solution produces exactly one .nupkg per package. -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>PerformanceSharp.Analyzers</PackageId>
    <Description>Roslyn analyzers and code fixes focused on runtime performance: allocations, collection and LINQ usage, string handling, async, and faster API selection.</Description>
    <PackageTags>analyzers;roslyn;codefix;performancesharp;performance;allocations;linq;strings;async</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Analyzer-only package: no lib/ folder, so the empty dependency group is expected. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Referenced for build ordering only; the assemblies are packed as files below. -->

  <ItemGroup>
    <ProjectReference Include="..\PerformanceSharp.Analyzers\PerformanceSharp.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.CodeFixes\PerformanceSharp.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.Roslyn414\PerformanceSharp.Analyzers.Roslyn414.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn414\PerformanceSharp.Analyzers.CodeFixes.Roslyn414.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.Roslyn53\PerformanceSharp.Analyzers.Roslyn53.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn53\PerformanceSharp.Analyzers.CodeFixes.Roslyn53.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.Roslyn59\PerformanceSharp.Analyzers.Roslyn59.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn59\PerformanceSharp.Analyzers.CodeFixes.Roslyn59.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Plain files, not TargetsForTfmSpecificContentInPackage: that hook runs per target framework
       and would offer this framework-agnostic path repeatedly. -->

  <ItemGroup>
    <None Include="..\PerformanceSharp.Analyzers\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.Roslyn414\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.14/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn414\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.14/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.Roslyn53\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn53\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.Roslyn59\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="..\PerformanceSharp.Analyzers.CodeFixes.Roslyn59\bin\$(Configuration)\netstandard2.0\PerformanceSharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="build\PerformanceSharp.Analyzers.targets" Pack="true" PackagePath="build\PerformanceSharp.Analyzers.targets;buildTransitive\PerformanceSharp.Analyzers.targets" Visible="false" />
  </ItemGroup>

</Project>
