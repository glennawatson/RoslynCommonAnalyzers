<Project>

  <PropertyGroup>
    <!-- The oldest analyzers/dotnet/roslyn<version>/cs slot this package ships. -->
    <_PerformanceSharpMinimumCompilerVersion>4.8</_PerformanceSharpMinimumCompilerVersion>
  </PropertyGroup>

  <!--
    Narrow the shipped slots to one. Only the .NET SDK does this itself; a non-SDK project receives
    every slot and loads the analyzer four times, reporting each diagnostic four times. Needs
    $(CompilerApiVersion), which is set after .props evaluation, hence a target. Guards fail open to
    the oldest slot.
  -->
  <Target Name="PerformanceSharpSelectAnalyzerSlot"
          BeforeTargets="CoreCompile"
          Condition="'$(Language)' == 'C#'">
    <PropertyGroup>
      <_PerformanceSharpCompilerVersion Condition="'$(CompilerApiVersion)' != '' and $(CompilerApiVersion.StartsWith('roslyn'))">$(CompilerApiVersion.Substring(6))</_PerformanceSharpCompilerVersion>
      <_PerformanceSharpCompilerVersion Condition="'$(_PerformanceSharpCompilerVersion)' == '' or !$(_PerformanceSharpCompilerVersion.Contains('.'))">$(_PerformanceSharpMinimumCompilerVersion)</_PerformanceSharpCompilerVersion>

      <!-- Assigned in ascending order, so the last condition that holds leaves the highest usable slot. -->
      <_PerformanceSharpSlot>roslyn4.8</_PerformanceSharpSlot>
      <_PerformanceSharpSlot Condition="'$([System.Version]::Parse($(_PerformanceSharpCompilerVersion)).CompareTo($([System.Version]::Parse('4.14'))))' &gt;= '0'">roslyn4.14</_PerformanceSharpSlot>
      <_PerformanceSharpSlot Condition="'$([System.Version]::Parse($(_PerformanceSharpCompilerVersion)).CompareTo($([System.Version]::Parse('5.3'))))' &gt;= '0'">roslyn5.3</_PerformanceSharpSlot>
      <_PerformanceSharpSlot Condition="'$([System.Version]::Parse($(_PerformanceSharpCompilerVersion)).CompareTo($([System.Version]::Parse('5.9'))))' &gt;= '0'">roslyn5.9</_PerformanceSharpSlot>
    </PropertyGroup>

    <ItemGroup>
      <_PerformanceSharpAnalyzer Include="@(Analyzer)"
                       Condition="'%(Analyzer.Filename)' == 'PerformanceSharp.Analyzers' or '%(Analyzer.Filename)' == 'PerformanceSharp.Analyzers.CodeFixes'">
        <_Slot>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(Analyzer.FullPath)'))))))</_Slot>
      </_PerformanceSharpAnalyzer>

      <Analyzer Remove="@(_PerformanceSharpAnalyzer)" Condition="'%(_PerformanceSharpAnalyzer._Slot)' != '$(_PerformanceSharpSlot)'" />
    </ItemGroup>

    <!--
      Fail loudly on a compiler older than the oldest slot. NuGet asset selection drops a slot newer
      than the host compiler without reporting anything, so such a consumer would otherwise install the
      package, see no diagnostics at all, and have no hint as to why.
    -->
    <Error Condition="'$(CompilerApiVersion)' != ''
                      and $(CompilerApiVersion.StartsWith('roslyn'))
                      and $(_PerformanceSharpCompilerVersion.Contains('.'))
                      and '$([System.Version]::Parse($(_PerformanceSharpMinimumCompilerVersion)).CompareTo($([System.Version]::Parse($(_PerformanceSharpCompilerVersion)))))' &gt; '0'"
           Code="PERFSHARP100"
           Text="PerformanceSharp.Analyzers requires Roslyn $(_PerformanceSharpMinimumCompilerVersion) or later (Visual Studio 2022 17.8+, or .NET SDK 8.0.100+), but this project is building with Roslyn $(_PerformanceSharpCompilerVersion). Upgrade the build tools to get these diagnostics." />
  </Target>

</Project>
