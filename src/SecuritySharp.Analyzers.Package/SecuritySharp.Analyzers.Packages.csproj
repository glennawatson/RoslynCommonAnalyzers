<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- One of the packable projects in the repo (see Directory.Build.props); everything else is
         non-packable so a `dotnet pack` of the solution produces exactly one .nupkg per package. -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SecuritySharp.Analyzers</PackageId>
    <Description>Roslyn analyzers and code fixes focused on runtime security: cryptography, transport protection, secret handling, injection sinks, unsafe deserialization, web hardening, and AI input trust boundaries.</Description>
    <PackageTags>analyzers;roslyn;codefix;securitysharp;security;cryptography;injection;secrets;serialization</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Analyzer-only package: no lib/ folder, so the empty dependency group is expected. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- One project per Roslyn slot, each building the same source against its own compiler. Referenced
       so a plain solution build produces every slot before this project packs them; the assemblies
       themselves are not referenced, only ordered. -->
  <ItemGroup>
    <ProjectReference Include="..\SecuritySharp.Analyzers\SecuritySharp.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.CodeFixes\SecuritySharp.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.Roslyn414\SecuritySharp.Analyzers.Roslyn414.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn414\SecuritySharp.Analyzers.CodeFixes.Roslyn414.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.Roslyn53\SecuritySharp.Analyzers.Roslyn53.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn53\SecuritySharp.Analyzers.CodeFixes.Roslyn53.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.Roslyn59\SecuritySharp.Analyzers.Roslyn59.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn59\SecuritySharp.Analyzers.CodeFixes.Roslyn59.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Packed as plain files rather than through TargetsForTfmSpecificContentInPackage: that hook runs once
    per target framework, and the analyzers folder is framework-agnostic, so it would offer the same
    path repeatedly. The SDK picks the highest slot at or below the host's CompilerApiVersion; the
    accompanying .targets narrows the choice for builds that do not do that themselves.
  -->
  <ItemGroup>
    <None Include="..\SecuritySharp.Analyzers\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.Roslyn414\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.14/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn414\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.14/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.Roslyn53\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn53\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.Roslyn59\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="..\SecuritySharp.Analyzers.CodeFixes.Roslyn59\bin\$(Configuration)\netstandard2.0\SecuritySharp.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="build\SecuritySharp.Analyzers.targets" Pack="true" PackagePath="build\SecuritySharp.Analyzers.targets;buildTransitive\SecuritySharp.Analyzers.targets" Visible="false" />
  </ItemGroup>

</Project>
