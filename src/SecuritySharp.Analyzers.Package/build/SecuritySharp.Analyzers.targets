<Project>

  <PropertyGroup>
    <!-- The oldest analyzers/dotnet/roslyn<version>/cs slot this package ships. -->
    <_SecuritySharpMinimumCompilerVersion>4.8</_SecuritySharpMinimumCompilerVersion>
  </PropertyGroup>

  <!--
    Narrow the shipped slots to one. Only the .NET SDK does this itself; a non-SDK project receives
    every slot and loads the analyzer four times, reporting each diagnostic four times. Needs
    $(CompilerApiVersion), which is set after .props evaluation, hence a target. Guards fail open to
    the oldest slot.
  -->
  <Target Name="SecuritySharpSelectAnalyzerSlot"
          BeforeTargets="CoreCompile"
          Condition="'$(Language)' == 'C#'">
    <PropertyGroup>
      <_SecuritySharpCompilerVersion Condition="'$(CompilerApiVersion)' != '' and $(CompilerApiVersion.StartsWith('roslyn'))">$(CompilerApiVersion.Substring(6))</_SecuritySharpCompilerVersion>
      <_SecuritySharpCompilerVersion Condition="'$(_SecuritySharpCompilerVersion)' == '' or !$(_SecuritySharpCompilerVersion.Contains('.'))">$(_SecuritySharpMinimumCompilerVersion)</_SecuritySharpCompilerVersion>

      <!-- Assigned in ascending order, so the last condition that holds leaves the highest usable slot. -->
      <_SecuritySharpSlot>roslyn4.8</_SecuritySharpSlot>
      <_SecuritySharpSlot Condition="'$([System.Version]::Parse($(_SecuritySharpCompilerVersion)).CompareTo($([System.Version]::Parse('4.14'))))' &gt;= '0'">roslyn4.14</_SecuritySharpSlot>
      <_SecuritySharpSlot Condition="'$([System.Version]::Parse($(_SecuritySharpCompilerVersion)).CompareTo($([System.Version]::Parse('5.3'))))' &gt;= '0'">roslyn5.3</_SecuritySharpSlot>
      <_SecuritySharpSlot Condition="'$([System.Version]::Parse($(_SecuritySharpCompilerVersion)).CompareTo($([System.Version]::Parse('5.9'))))' &gt;= '0'">roslyn5.9</_SecuritySharpSlot>
    </PropertyGroup>

    <ItemGroup>
      <_SecuritySharpAnalyzer Include="@(Analyzer)"
                       Condition="'%(Analyzer.Filename)' == 'SecuritySharp.Analyzers' or '%(Analyzer.Filename)' == 'SecuritySharp.Analyzers.CodeFixes'">
        <_Slot>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(Analyzer.FullPath)'))))))</_Slot>
      </_SecuritySharpAnalyzer>

      <Analyzer Remove="@(_SecuritySharpAnalyzer)" Condition="'%(_SecuritySharpAnalyzer._Slot)' != '$(_SecuritySharpSlot)'" />
    </ItemGroup>

    <!--
      Fail loudly on a compiler older than the oldest slot. NuGet asset selection drops a slot newer
      than the host compiler without reporting anything, so such a consumer would otherwise install the
      package, see no diagnostics at all, and have no hint as to why.
    -->
    <Error Condition="'$(CompilerApiVersion)' != ''
                      and $(CompilerApiVersion.StartsWith('roslyn'))
                      and $(_SecuritySharpCompilerVersion.Contains('.'))
                      and '$([System.Version]::Parse($(_SecuritySharpMinimumCompilerVersion)).CompareTo($([System.Version]::Parse($(_SecuritySharpCompilerVersion)))))' &gt; '0'"
           Code="SECSHARP100"
           Text="SecuritySharp.Analyzers requires Roslyn $(_SecuritySharpMinimumCompilerVersion) or later (Visual Studio 2022 17.8+, or .NET SDK 8.0.100+), but this project is building with Roslyn $(_SecuritySharpCompilerVersion). Upgrade the build tools to get these diagnostics." />
  </Target>

</Project>
