<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SecuritySharp.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecuritySharp.Analyzers.CodeFixes" />
    <InternalsVisibleTo Include="SecuritySharp.Analyzers.Benchmarks" />
    <InternalsVisibleTo Include="SecuritySharp.Analyzers.Tests" />
    <InternalsVisibleTo Include="SecuritySharp.Analyzers.Tests.Roslyn53" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis.CSharp" />
    <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax" />
    <Using Include="Microsoft.CodeAnalysis.Diagnostics" />
    <Using Include="RoslynCommon.Analyzers" />
  </ItemGroup>

  <!-- The same rules, compiled a second time against roslyn5.3's compiler. Nothing is duplicated: the
       leaves differ only in which Roslyn they bind to and what the ROSLYN_*_OR_GREATER constants
       turn on. Only the floor project owns files on disk. -->
  <ItemGroup>
    <Compile Include="..\SecuritySharp.Analyzers\**\*.cs"
             Exclude="..\SecuritySharp.Analyzers\bin\**\*.cs;..\SecuritySharp.Analyzers\obj\**\*.cs"
             LinkBase="SecuritySharp.Analyzers" />
    <Compile Include="..\Shared\Analyzers\*.cs" Link="Helpers\Shared\%(Filename).cs" />
  </ItemGroup>

  <!-- Release tracking reads these through AdditionalFiles. The SDK auto-includes them from the
       project directory, which does not reach a linked copy, so they are named explicitly. -->
  <ItemGroup>
    <AdditionalFiles Include="..\SecuritySharp.Analyzers\AnalyzerReleases.Shipped.md" Link="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\SecuritySharp.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
