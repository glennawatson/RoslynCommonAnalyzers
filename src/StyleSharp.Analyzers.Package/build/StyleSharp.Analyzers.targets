<Project>

  <PropertyGroup>
    <!-- The oldest analyzers/dotnet/roslyn<version>/cs slot this package ships. -->
    <_StyleSharpMinimumCompilerVersion>4.8</_StyleSharpMinimumCompilerVersion>
  </PropertyGroup>

  <!-- A non-SDK project gets every slot at once, so drop all but the one this compiler is served by. -->
  <Target Name="StyleSharpSelectAnalyzerSlot"
          BeforeTargets="CoreCompile"
          Condition="'$(Language)' == 'C#'">
    <PropertyGroup>
      <_StyleSharpCompilerVersion Condition="'$(CompilerApiVersion)' != '' and $(CompilerApiVersion.StartsWith('roslyn'))">$(CompilerApiVersion.Substring(6))</_StyleSharpCompilerVersion>
      <_StyleSharpCompilerVersion Condition="'$(_StyleSharpCompilerVersion)' == '' or !$(_StyleSharpCompilerVersion.Contains('.'))">$(_StyleSharpMinimumCompilerVersion)</_StyleSharpCompilerVersion>

      <!-- Ascending, so the last matching condition wins. -->
      <_StyleSharpSlot>roslyn4.8</_StyleSharpSlot>
      <_StyleSharpSlot Condition="$([MSBuild]::VersionGreaterThanOrEquals($(_StyleSharpCompilerVersion), '4.14'))">roslyn4.14</_StyleSharpSlot>
      <_StyleSharpSlot Condition="$([MSBuild]::VersionGreaterThanOrEquals($(_StyleSharpCompilerVersion), '5.3'))">roslyn5.3</_StyleSharpSlot>
      <_StyleSharpSlot Condition="$([MSBuild]::VersionGreaterThanOrEquals($(_StyleSharpCompilerVersion), '5.9'))">roslyn5.9</_StyleSharpSlot>
    </PropertyGroup>

    <ItemGroup>
      <_StyleSharpAnalyzer Include="@(Analyzer)"
                       Condition="'%(Analyzer.Filename)' == 'StyleSharp.Analyzers' or '%(Analyzer.Filename)' == 'StyleSharp.Analyzers.CodeFixes'">
        <_Slot>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(Analyzer.FullPath)'))))))</_Slot>
      </_StyleSharpAnalyzer>

      <Analyzer Remove="@(_StyleSharpAnalyzer)" Condition="'%(_StyleSharpAnalyzer._Slot)' != '$(_StyleSharpSlot)'" />
    </ItemGroup>

    <!-- NuGet drops a too-new slot silently, so say so rather than reporting nothing. -->
    <Error Condition="'$(CompilerApiVersion)' != ''
                      and $(CompilerApiVersion.StartsWith('roslyn'))
                      and $(_StyleSharpCompilerVersion.Contains('.'))
                      and $([MSBuild]::VersionLessThan($(_StyleSharpCompilerVersion), $(_StyleSharpMinimumCompilerVersion)))"
           Code="STYLESHARP100"
           Text="StyleSharp.Analyzers requires Roslyn $(_StyleSharpMinimumCompilerVersion) or later (Visual Studio 2022 17.8+, or .NET SDK 8.0.100+), but this project is building with Roslyn $(_StyleSharpCompilerVersion). Upgrade the build tools to get these diagnostics." />
  </Target>

</Project>
