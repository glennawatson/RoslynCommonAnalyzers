<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StyleSharp.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StyleSharp.Analyzers.CodeFixes" />
    <InternalsVisibleTo Include="StyleSharp.Analyzers.Benchmarks" />
    <InternalsVisibleTo Include="StyleSharp.Analyzers.Tests" />
    <InternalsVisibleTo Include="StyleSharp.Analyzers.Tests.Roslyn59" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis.CSharp" />
    <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax" />
    <Using Include="Microsoft.CodeAnalysis.Diagnostics" />
    <Using Include="RoslynCommon.Analyzers" />
  </ItemGroup>

  <!-- The same source, compiled against this slot's compiler. -->

  <ItemGroup>
    <Compile Include="..\StyleSharp.Analyzers\**\*.cs"
             Exclude="..\StyleSharp.Analyzers\bin\**\*.cs;..\StyleSharp.Analyzers\obj\**\*.cs"
             LinkBase="StyleSharp.Analyzers" />
    <Compile Include="..\Shared\Analyzers\*.cs" Link="Helpers\Shared\%(Filename).cs" />
  </ItemGroup>

  <!-- Named explicitly: the SDK's auto-include does not reach a linked copy. -->

  <ItemGroup>
    <AdditionalFiles Include="..\StyleSharp.Analyzers\AnalyzerReleases.Shipped.md" Link="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\StyleSharp.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- The manifest name has to match the floor's, which the linked designer binds to. -->

  <ItemGroup>
    <EmbeddedResource Include="..\StyleSharp.Analyzers\Resources.resx"
                      Link="Resources.resx"
                      LogicalName="StyleSharp.Analyzers.Resources.resources" />
  </ItemGroup>

</Project>
