<?xml version="1.0" encoding="utf-8"?><Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same tests against this slot's analyzers. One TFM: the compiler varies here, not the runtime. -->
    <TargetFrameworks>$(AnalyzerTestTargets)</TargetFrameworks>
    <RootNamespace>PerformanceSharp.Analyzers.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PerformanceSharp.Analyzers.CodeFixes.Roslyn53\PerformanceSharp.Analyzers.CodeFixes.Roslyn53.csproj" />
    <ProjectReference Include="..\..\PerformanceSharp.Analyzers.Roslyn53\PerformanceSharp.Analyzers.Roslyn53.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RoslynCommon.Analyzers" />
    <Using Include="RoslynCommon.Analyzers.CodeFixes" />
  </ItemGroup>

  <!-- No test source of its own: it recompiles the baseline project's files against the other slot. -->
  <ItemGroup>
    <Compile Include="..\PerformanceSharp.Analyzers.Tests\**\*.cs" Exclude="..\PerformanceSharp.Analyzers.Tests\bin\**\*.cs;..\PerformanceSharp.Analyzers.Tests\obj\**\*.cs" LinkBase="PerformanceSharp.Analyzers.Tests" />
    <Compile Include="..\..\Shared\Tests\*.cs" Link="Verifiers\Shared\%(Filename).cs" />
  </ItemGroup>

</Project>
