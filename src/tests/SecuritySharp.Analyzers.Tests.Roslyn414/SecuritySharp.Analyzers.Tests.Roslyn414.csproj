<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same tests against this slot's analyzers. One TFM: the compiler varies here, not the runtime. -->
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>SecuritySharp.Analyzers.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.CodeRefactoring.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SecuritySharp.Analyzers.CodeFixes.Roslyn414\SecuritySharp.Analyzers.CodeFixes.Roslyn414.csproj" />
    <ProjectReference Include="..\..\SecuritySharp.Analyzers.Roslyn414\SecuritySharp.Analyzers.Roslyn414.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RoslynCommon.Analyzers" />
    <Using Include="RoslynCommon.Analyzers.CodeFixes" />
  </ItemGroup>

  <!-- No test source of its own: it recompiles the baseline project's files against the other slot. -->
  <ItemGroup>
    <Compile Include="..\SecuritySharp.Analyzers.Tests\**\*.cs"
             Exclude="..\SecuritySharp.Analyzers.Tests\bin\**\*.cs;..\SecuritySharp.Analyzers.Tests\obj\**\*.cs"
             LinkBase="SecuritySharp.Analyzers.Tests" />
    <Compile Include="..\..\Shared\Tests\*.cs" Link="Verifiers\Shared\%(Filename).cs" />
  </ItemGroup>

</Project>
